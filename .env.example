# Copy to .env. Compose passes credentials only to services that need them.
# Required: choose a long random token, shared privately by the web runner and market.
BAZAAR_RUNNER_TOKEN=

# Required to execute strategies and judges with the default gateway models.
PYDANTIC_AI_GATEWAY_API_KEY=
BAZAAR_AGENT_MODEL=gateway/openai:gpt-5.6-sol
BAZAAR_JUDGE_MODEL=gateway/anthropic:claude-sonnet-5-5
BAZAAR_STRATEGY_EVAL_ENABLED=1

# Required to export online evaluations and traces; judge results are not stored locally.
LOGFIRE_TOKEN=
BAZAAR_ENVIRONMENT=development
# Optional dashboard URL template containing {strategy}.
BAZAAR_LOGFIRE_DASHBOARD_URL=
BAZAAR_ADMIN_TOKEN=
PUBLIC_URL=http://localhost:8080

# Alpaca keys, used by the containerized snapshot downloader (bars and news).
# Both the key id and the secret are required on every request.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional. SEC EDGAR filing text is downloaded only when this names a contact address, for example:
# SEC_USER_AGENT="Bazaar research you@example.com"
SEC_USER_AGENT=

# Bars/news resume within a version; changed EDGAR metadata needs a new snapshot version.
BAZAAR_SNAPSHOT_VERSION=demo
# SIP matches the default dataset. IEX differs; do not mix feeds in a snapshot version.
BAZAAR_ALPACA_FEED=sip
