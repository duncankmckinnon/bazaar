# Alpaca keys, used by `python -m bazaar_market.sources news` and `capture-news`.
# Both the key id and the secret are required on every request.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional. SEC EDGAR filing text is downloaded only when this names a contact address, for example:
# SEC_USER_AGENT="Bazaar research you@example.com"
SEC_USER_AGENT=
